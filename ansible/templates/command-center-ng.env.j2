# Private runtime configuration; passwords are never stored here.
PATH={{ command_center_path | to_json }}
CODEX_HOME={{ ccng_codex_home | to_json }}
CCNG_CONFIG_DIR={{ ccng_config_dir | to_json }}
{% for name, value in command_center_claude_environment | default({}) | dictsort %}
{{ name }}={{ value | to_json(ensure_ascii=false) }}
{% endfor %}
# Listener and certificate settings are read from INSTALLDIR/etc/config.conf.
